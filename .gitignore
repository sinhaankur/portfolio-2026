# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Personal genomic data must NEVER be committed to this PUBLIC repo — neither
# the raw CSV nor the encrypted derived blob. Ankur's own genome lives in a
# separate PRIVATE repo. This public site is upload-your-own-file only.
*raw_dna*.csv
*MyHeritage*.csv
public/data/dna.enc.json

# Private interview prep (personal docs — never ship to the public repo).
/interview-prep

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# macOS
.DS_Store

# editor / tool configs that shouldn't ride along on the repo
.vscode/
.claude/
.idea/
# ...but DO version the build-agent definitions + slash commands so the Helion
# build agent persists across machines and is part of the repo's tooling.
# Re-include the .claude dir, then keep only agents/ + commands/ — settings and
# skills stay ignored. (Git can't re-include a child if its parent stays excluded,
# so .claude/ must be negated first, then the unwanted children re-ignored.)
!.claude/
.claude/*
!.claude/agents/
!.claude/commands/

# downloaded 3D asset variants kept locally for reference but not shipped
# (the variant we actually ship lives in public/models/)
/blackhole.glb
/blackhole-2.glb
/Blackhole.usdz
/blackhole/
/blackhole-2/
# Data-fetch script cache (raw CSVs the build scripts download).
# The trimmed output goes to lib/data/ and IS committed.
scripts/.cache/

# Third-party reference models (heavy, not ours to redistribute)
blender/space-assets/reference/

# Blender backup saves
*.blend1

# Python bytecode + virtualenvs from Blender/data build scripts. The venv is a
# local convenience (deps only) — never part of the repo.
__pycache__/
.venv/
venv/
*.pyc

# Blender master + backups now live in the dedicated assets repo
# (sinhaankur/star-cleaver-assets). Don't re-commit the heavy sources here.
blender/space-assets/space-assets.blend
blender/space-assets/glb-backup/
blender/space-assets/*.glb
blender/space-assets/bodies/
blender/space-assets/small-bodies/

# Celestial globes: the packed .blend files embed 8K textures (80-130MB each).
# Rebuild them from scripts/render-celestial-globes.py + the maps/ folder.
blender/space-assets/celestial/*.blend

# packaged webOS artifacts — build outputs, not source
*.ipk
